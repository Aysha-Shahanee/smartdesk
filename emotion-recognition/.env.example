# Emotion detection needs no configuration to run. It stores everything in the
# backend's local SQLite database and sends nothing off the machine.
#
# The keys below belong to the retained-but-unused Supabase sync prototype
# (see RAF-DB-improvement/storage/supabase_sync.py). Nothing imports it, so
# setting these has no effect today. They are listed only so the prototype is
# self-documenting if someone picks it up later.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_key
