.env
backend/.env

# Python virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Python cache/compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
pytest-cache-files-*/

# Runtime databases and logs
*.db
*.db.backup*
*.sqlite
*.sqlite3
*.log
emotion_15min_blocks*.jsonl

# Backups / checkpoints
*.backup
*.backup_before_*
*.bak

# Node artifacts
node_modules/
*.vsix

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Archive files (don't commit large zips)
*.zip

# Google auth tokens for gspread
.config/gspread/
AppData/Roaming/gspread/
# Google Calendar OAuth secrets & sync state (never commit)
backend/calendar_store/

# Trained classifier + bundled encoder weights. Regenerated by training and
# by scripts/export_embedding_model.py; ~88 MB, and the classifier is derived
# from personal labels.
backend/model_store/

# Cached embeddings of activity segments. Derived data, regenerable, and
# computed from window titles and URLs — not something to keep in git.
backend/features/
