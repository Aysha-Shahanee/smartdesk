# Environment & secrets
.env
backend/.env
*.pem

# Python virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Project-local development tools and tunnel state
.tools/
.cloudflared/
.smartdesk-dev/
cloudflared.yml
cloudflared.yaml

# Hypothesis keeps a database of falsifying examples it has found. Useful
# locally — it replays a known failure first on the next run — and meaningless
# to anyone else, since the examples are specific to one machine's run history.
.hypothesis/

# Python cache/compiled files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
backend/.pytest_cache/
pytest-cache-files-*/

# Runtime databases and logs
*.db
*.db.backup*
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.log

# Backups / checkpoints
*.backup
*.backup_before_*
*.bak

# Node artifacts
node_modules/
*.vsix

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Archive files (don't commit large zips)
*.zip

# Google auth tokens for gspread
.config/gspread/
AppData/Roaming/gspread/
# Google Calendar OAuth secrets & sync state (never commit)
backend/calendar_store/

# Trained classifier + bundled encoder weights. Regenerated by training and
# by scripts/export_embedding_model.py; ~88 MB, and the classifier is derived
# from personal labels.
backend/model_store/

# Cached embeddings of activity segments. Derived data, regenerable, and
# computed from window titles and URLs — not something to keep in git.
backend/features/

# SmartDesk v2 keeps the active MediaPipe fallback model under emotion-recognition/smartdesk_v2/models.
backend/models/face_landmarker.task


# Scratch repos for prediction / IDE-activity testing. Each carries its own
# .git pointing at the smartdesk-prediction-test org, so committing them would
# record a broken gitlink. Kept on disk, out of this repo's history.
smartdesk-backend-test/
smartdesk-extension-test/
smartdesk-frontend-test/
