{
  "name": "smartdesk-ide-logger",
  "displayName": "smartdesk-ide-logger",
  "description": "SmartDesk IDE activity logger",
  "version": "0.0.1",
  "publisher": "smartdesk",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SmartDesk",
      "properties": {
        "smartdesk.userId": {
          "type": "string",
          "default": "",
          "description": "Your SmartDesk user ID (leave blank to use machine hostname)"
        },
        "smartdesk.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "SmartDesk backend URL"
        }
      }
    },
    "commands": [
      {
        "command": "smartdesk.showLogLocation",
        "title": "SmartDesk: Show Log Location"
      },
      {
        "command": "smartdesk.openDashboard",
        "title": "SmartDesk: Open IDE Demo Dashboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}