{
  "manifest_version": 3,
  "name": "SmartDesk Tracker",
  "version": "1.0.0",
  "description": "Tracks browser activity for SmartDesk developer productivity dashboard",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}