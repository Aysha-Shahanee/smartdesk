# ============================================
# SmartDesk Backend Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Core Settings ---
DATABASE_URL=sqlite:///./smartdesk.db
DEFAULT_USER_ID=local_user
LOG_LEVEL=INFO

# All stored/returned timestamps use this timezone (IANA name)
TIMEZONE=Asia/Colombo

# Identifies which device collected each row (multi-device aggregation).
# Leave empty to auto-detect the machine hostname.
DEVICE_ID=

# --- CORS Origins (comma-separated) ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:1420","chrome-extension://*"]

# --- Google Calendar OAuth Configuration ---
# To enable Google Calendar integration you need Google OAuth client
# credentials (type: Desktop App).
#
# How to get these:
#   1. Go to https://console.cloud.google.com/
#   2. Create or select a project
#   3. Enable the Google Calendar API
#   4. Configure OAuth consent screen
#   5. Create OAuth 2.0 Client ID (type: Desktop App)
#   6. EITHER paste the client id/secret below (option A)
#      OR download the JSON and save it as calendar_store/credentials.json (option B)
#
# Guides:
#   - Calendar quickstart: https://developers.google.com/workspace/calendar/api/quickstart/python
#   - Create credentials: https://developers.google.com/workspace/guides/create-credentials

# Option A: env vars (take priority when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Option B: credentials file path
GOOGLE_CREDENTIALS_FILE=./calendar_store/credentials.json

# Tokens and sync state are stored here (gitignored)
CALENDAR_STORE_DIR=./calendar_store
CALENDAR_SYNC_INTERVAL_MIN=15
CALENDAR_SYNC_PAST_DAYS=30
CALENDAR_SYNC_FUTURE_DAYS=60

# Used to build the OAuth redirect URI
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- GitHub App / Projects v2 Integration ---
SMARTDESK_GITHUB_APP_ID=
SMARTDESK_GITHUB_APP_SLUG=
# PEM content may be stored on one line using literal \n separators.
SMARTDESK_GITHUB_APP_PRIVATE_KEY=
SMARTDESK_GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback
# GitHub App user-authorization credentials. Required when the App is installed
# on an organization so SmartDesk can identify the human user authoritatively.
SMARTDESK_GITHUB_OAUTH_CLIENT_ID=
SMARTDESK_GITHUB_OAUTH_CLIENT_SECRET=
SMARTDESK_GITHUB_USER_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/user-callback
SMARTDESK_FRONTEND_URL=http://localhost:5173
SMARTDESK_GITHUB_WEBHOOK_SECRET=
SMARTDESK_GITHUB_MONITOR_MODE=webhook
# Optional override; defaults to backend/model_artifacts/github_effort.
SMARTDESK_GITHUB_MODEL_ARTIFACT_DIR=
# --- Shared label sheet (optional) ---
# Mirrors every typed label correction to a Google Sheet so a team can pool
# training data. The database is always written first and stays the source of
# truth; the sheet is best-effort and never blocks a correction.
#
# Note the sheet receives window titles and URLs alongside the label. Anyone
# with access to the spreadsheet can read them.
#
# Requires a one-time credential cache:
#   python -c "import gspread; gspread.oauth()"
# Anything a failed sync drops is recoverable:
#   python scripts/export_labels_to_sheet.py --apply
ENABLE_GSHEET_SYNC=false
GSHEET_KEY=1G_oudT83kv-JSugqzbVE-nbLyjmQ0c7YY5EGpbLUaG8
GSHEET_WORKSHEET=Labels
