# ============================================
# SmartDesk Backend Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Core Settings ---
DATABASE_URL=sqlite:///./smartdesk.db
DEFAULT_USER_ID=local_user
LOG_LEVEL=INFO

# --- CORS Origins (comma-separated) ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:1420","chrome-extension://*"]

# --- Background Task Intervals ---
# CALENDAR_SYNC_INTERVAL_SEC=900
# SESSION_SCHEDULER_INTERVAL_SEC=60
# SESSION_SCHEDULER_WINDOW_MINUTES=30

# --- Google Calendar OAuth Configuration ---
# To enable Google Calendar integration, you need Google OAuth client credentials.
#
# How to get these:
#   1. Go to https://console.cloud.google.com/
#   2. Create or select a project
#   3. Enable the Google Calendar API
#   4. Configure OAuth consent screen
#   5. Create OAuth 2.0 Client ID (type: Desktop App)
#   6. Copy the values below from the downloaded JSON file
#
# Guides:
#   - Calendar quickstart: https://developers.google.com/workspace/calendar/api/quickstart/python
#   - Create credentials: https://developers.google.com/workspace/guides/create-credentials

SMARTDESK_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SMARTDESK_GOOGLE_CLIENT_SECRET=your-client-secret
SMARTDESK_GOOGLE_PROJECT_ID=your-google-cloud-project-id

# --- GitHub App and Projects v2 Integration ---
# Create a GitHub App with organization Projects: Read permission, subscribe to
# projects_v2_item events, and set its Setup URL to the callback below.
SMARTDESK_GITHUB_APP_ID=
SMARTDESK_GITHUB_APP_SLUG=
# PEM text may use literal \n sequences in a one-line .env value.
SMARTDESK_GITHUB_APP_PRIVATE_KEY=
SMARTDESK_GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback
# Configure the same secret on the GitHub webhook.
SMARTDESK_GITHUB_WEBHOOK_SECRET=
# Integrated SmartDesk uses webhooks; the standalone collector keeps polling.
SMARTDESK_GITHUB_MONITOR_MODE=webhook
# Defaults to backend/model_artifacts/github_effort when omitted.
# SMARTDESK_GITHUB_MODEL_ARTIFACT_DIR=C:/absolute/path/only-when-overriding
