{
  "manifest_version": 2,
  "name": "Activity Tracker",
  "version": "1.0",
  "description": "Tracks active tabs and page visits",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "idle",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartdesk-activity-tracker@example.com",
      "strict_min_version": "109.0"
    }
  }
}